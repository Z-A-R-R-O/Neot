generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id                  String    @id
  email               String?
  fullName            String?   @map("full_name")
  avatarUrl           String?   @map("avatar_url")
  role                String    @default("student")
  passwordHash        String?   @map("password_hash")
  ageGroup            String?   @map("age_group")
  parentId            String?   @map("parent_id")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  metadata            String    @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  xp               Int       @default(0)
  level            Int       @default(1)
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date")

  parent  Profile?  @relation("ParentChild", fields: [parentId], references: [id])
  children Profile[] @relation("ParentChild")

  courses    Course[]
  enrollments Enrollment[]
  lessonProgress LessonProgress[]
  xpTransactions XPTransaction[]
  userAchievements UserAchievement[]
  certificates Certificate[]
  notifications Notification[]
  sessions Session[]
  mediaUploads Media[]

  @@map("profiles")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  courses Course[]

  @@map("categories")
}

model Course {
  id               String   @id @default(uuid())
  title            String
  description      String?
  thumbnailUrl     String?  @map("thumbnail_url")
  categoryId       String?  @map("category_id")
  teacherId        String   @map("teacher_id")
  subject          String?
  gradeLevel       String?  @map("grade_level")
  ageRange         String?  @map("age_range")
  difficulty       String   @default("beginner")
  isAdaptive       Boolean  @default(false) @map("is_adaptive")
  status           String   @default("draft")
  estimatedMinutes Int?     @map("estimated_minutes")
  metadata         String   @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category  Category?  @relation(fields: [categoryId], references: [id])
  teacher   Profile    @relation(fields: [teacherId], references: [id])
  modules   Module[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@map("courses")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id               String   @id @default(uuid())
  moduleId         String   @map("module_id")
  title            String
  description      String?
  sortOrder        Int      @map("sort_order")
  content          String   @default("{}")
  estimatedMinutes Int?     @map("estimated_minutes")
  status           String   @default("draft")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  @@map("lessons")
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  status    String   @default("not_started")
  timeSpent Int      @default(0) @map("time_spent")
  score     Float?
  lastBlockIndex Int @default(0) @map("last_block_index")
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  archived    Boolean   @default(false)
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  lastLessonId String?  @map("last_lesson_id")
  lastAccessedAt DateTime? @map("last_accessed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model XPTransaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int
  reason      String
  referenceId String?  @map("reference_id")
  lessonId    String?  @map("lesson_id")
  quizId      String?  @map("quiz_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("xp_transactions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Achievement {
  id          String   @id
  name        String
  description String
  iconUrl     String?  @map("icon_url")
  xpReward    Int      @default(0) @map("xp_reward")
  criteria    String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at")

  user        Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model SiteTheme {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  tokens    String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_themes")
}

model CustomPage {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  path      String   @unique
  status    String   @default("draft")
  layout    String   @default("default")
  seo       String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections PageSection[]

  @@map("custom_pages")
}

model PageSection {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  blockType String   @map("block_type")
  sortOrder Int      @map("sort_order")
  content   String   @default("{}")
  settings  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_sections")
}

model BlockDefinition {
  id          String   @id @default(uuid())
  type        String   @unique
  label       String
  description String?
  scope       String   @default("lesson")
  icon        String?
  category    String   @default("general")
  schema      String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("block_definitions")
}

model Media {
  id          String   @id @default(uuid())
  filename    String
  originalName String  @map("original_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  url         String
  alt         String?
  uploadedById String  @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  uploadedBy Profile @relation(fields: [uploadedById], references: [id])

  @@map("media")
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  serial    String   @unique
  issuedAt  DateTime @default(now()) @map("issued_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certificates")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    @default("info")
  title     String
  message   String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model PlatformSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
