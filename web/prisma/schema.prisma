generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id                  String    @id
  email               String?
  emailVerified       DateTime? @map("email_verified")
  verificationToken   String?   @map("verification_token")
  fullName            String?   @map("full_name")
  avatarUrl           String?   @map("avatar_url")
  role                String    @default("student")
  status              String    @default("active")
  passwordHash        String?   @map("password_hash")
  ageGroup            String?   @map("age_group")
  parentId            String?   @map("parent_id")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  metadata            String    @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  xp               Int       @default(0)
  level            Int       @default(1)
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date")

  parent  Profile?  @relation("ParentChild", fields: [parentId], references: [id])
  children Profile[] @relation("ParentChild")

  courses    Course[]
  enrollments Enrollment[]
  lessonProgress LessonProgress[]
  xpTransactions XPTransaction[]
  userAchievements UserAchievement[]
  certificates Certificate[]
  bookmarks Bookmark[]
  lessonNotes LessonNote[]
  userBadges UserBadge[]
  reviews Review[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
  sessions Session[]
  mediaUploads Media[]
  sentMessages Message[] @relation("SenderMessages")
  receivedMessages Message[] @relation("RecipientMessages")

  @@map("profiles")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  courses Course[]

  @@map("categories")
}

model Course {
  id               String   @id @default(uuid())
  title            String
  description      String?
  thumbnailUrl     String?  @map("thumbnail_url")
  categoryId       String?  @map("category_id")
  teacherId        String   @map("teacher_id")
  subject          String?
  gradeLevel       String?  @map("grade_level")
  ageRange         String?  @map("age_range")
  difficulty       String   @default("beginner")
  isAdaptive       Boolean  @default(false) @map("is_adaptive")
  status           String   @default("draft")
  estimatedMinutes Int?     @map("estimated_minutes")
  metadata         String   @default("{}")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category  Category?  @relation(fields: [categoryId], references: [id])
  teacher   Profile    @relation(fields: [teacherId], references: [id])
  modules   Module[]
  enrollments Enrollment[]
  certificates Certificate[]
  tags CourseTag[]
  reviews Review[]

  @@map("courses")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  courses   CourseTag[]

  @@map("tags")
}

model CourseTag {
  courseId String @map("course_id")
  tagId    String @map("tag_id")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
  @@map("course_tags")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id               String   @id @default(uuid())
  moduleId         String   @map("module_id")
  title            String
  description      String?
  sortOrder        Int      @map("sort_order")
  content          String   @default("{}")
  estimatedMinutes Int?     @map("estimated_minutes")
  status           String   @default("draft")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress LessonProgress[]
  bookmarks Bookmark[]
  lessonNotes LessonNote[]

  @@map("lessons")
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  status    String   @default("not_started")
  timeSpent Int      @default(0) @map("time_spent")
  score     Float?
  lastBlockIndex Int @default(0) @map("last_block_index")
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  archived    Boolean   @default(false)
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  lastLessonId String?  @map("last_lesson_id")
  lastAccessedAt DateTime? @map("last_accessed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model XPTransaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int
  reason      String
  referenceId String?  @map("reference_id")
  lessonId    String?  @map("lesson_id")
  quizId      String?  @map("quiz_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("xp_transactions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Achievement {
  id          String   @id
  name        String
  description String
  iconUrl     String?  @map("icon_url")
  xpReward    Int      @default(0) @map("xp_reward")
  criteria    String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at")

  user        Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model SiteTheme {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  tokens    String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_themes")
}

model CustomPage {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  path      String   @unique
  status    String   @default("draft")
  layout    String   @default("default")
  layoutTemplateId String? @map("layout_template_id")
  seo       String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections       PageSection[]
  layoutTemplate LayoutTemplate? @relation(fields: [layoutTemplateId], references: [id])

  @@map("custom_pages")
}

model PageSection {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  blockType String   @map("block_type")
  sortOrder Int      @map("sort_order")
  slot      String   @default("main")
  content   String   @default("{}")
  settings  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_sections")
}

model BlockDefinition {
  id          String   @id @default(uuid())
  type        String   @unique
  label       String
  description String?
  scope       String   @default("lesson")
  icon        String?
  category    String   @default("general")
  schema      String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("block_definitions")
}

model Media {
  id          String   @id @default(uuid())
  filename    String
  originalName String  @map("original_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  url         String
  alt         String?
  folder      String   @default("uncategorized")
  uploadedById String  @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  uploadedBy Profile @relation(fields: [uploadedById], references: [id])

  @@index([folder])
  @@map("media")
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  serial    String   @unique
  issuedAt  DateTime @default(now()) @map("issued_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certificates")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("bookmarks")
}

model LessonNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  content   String
  blockId   String?  @map("block_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@map("lesson_notes")
}

model Badge {
  id          String   @id
  name        String
  description String
  iconUrl     String?
  category    String   @default("progress")
  criteria    String   @default("{}")
  xpReward    Int      @default(0) @map("xp_reward")
  createdAt   DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId  String   @map("user_id")
  badgeId String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Report {
  id          String   @id @default(uuid())
  type        String
  targetId    String   @map("target_id")
  reason      String
  reportedBy  String   @map("reported_by")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  userId     String?  @map("user_id")
  details    String   @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model DashboardConfig {
  id        String   @id @default(uuid())
  role      String
  widgets   String   @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role])
  @@map("dashboard_configs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String    @default("info")
  title     String
  message   String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model PlatformSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model PageTemplate {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  category    String   @default("page")
  sections    String   @default("[]")
  thumbnail   String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("page_templates")
}

model PageVersion {
  id         String   @id @default(uuid())
  pageId     String   @map("page_id")
  sections   String   @default("[]")
  versionTag String?  @map("version_tag")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([pageId])
  @@map("page_versions")
}

model NavItem {
  id        String   @id @default(uuid())
  label     String
  href      String
  icon      String?
  role      String   @default("all")
  parentId  String?  @map("parent_id")
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")

  parent   NavItem?  @relation("NavHierarchy", fields: [parentId], references: [id])
  children NavItem[] @relation("NavHierarchy")

  @@index([role])
  @@map("nav_items")
}

model PreviewToken {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("preview_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String   @default("{}")
  isBuiltIn   Boolean  @default(false) @map("is_built_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model ReusableBlock {
  id         String   @id @default(uuid())
  name       String
  description String?
  blockType  String   @map("block_type")
  content    String   @default("{}")
  settings   String   @default("{}")
  category   String   @default("general")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("reusable_blocks")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model ApiKey {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique
  prefix    String   @map("prefix")
  lastChars String   @map("last_chars")
  role      String   @default("admin")
  active    Boolean  @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([active])
  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  events    String   @default("[]")
  active    Boolean  @default(true)
  secret    String?
  timeoutMs Int      @default(5000) @map("timeout_ms")
  retryCount Int     @default(3) @map("retry_count")
  lastStatus String? @map("last_status")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("webhooks")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model LayoutTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String   @unique
  slots       String   @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pages CustomPage[]

  @@map("layout_templates")
}

model SeasonalEvent {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String?
  multiplier  Float    @default(1.0)
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  active      Boolean  @default(true)
  xpBonus     Int      @default(0) @map("xp_bonus")
  badgeId     String?  @map("badge_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("seasonal_events")
}

model UserSeasonalProgress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  eventId     String   @map("event_id")
  lessonsDone Int      @default(0) @map("lessons_done")
  xpEarned    Int      @default(0) @map("xp_earned")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventId])
  @@index([userId])
  @@map("user_seasonal_progress")
}

model Message {
  id        String   @id @default(uuid())
  senderId  String   @map("sender_id")
  recipientId String @map("recipient_id")
  subject   String
  content   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  sender    Profile @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient Profile @relation("RecipientMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([recipientId, readAt])
  @@map("messages")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  comment   String?
  approved  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("reviews")
}
